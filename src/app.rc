#include <windows.h>

// 应用图标（Prism）
IDI_APPICON ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Prism"
            VALUE "FileDescription",  "Prism — 多格视频播放器"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "Prism"
            VALUE "OriginalFilename", "volta.exe"
            VALUE "ProductName",      "Prism"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
